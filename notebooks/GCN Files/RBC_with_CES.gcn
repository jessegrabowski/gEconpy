symbols
{
    Y[]
    {
        name = "Output";
        bounds = (0, None);
    };
    C[]
    {
        name = "Consumption";
        bounds = (0, None);
    };
    I[]
    {
        name = "Investment";
        bounds = (0, None);
    };
    K[]
    {
        name = "Capital stock";
        bounds = (0, None);
    };
    L[]
    {
        name = "Hours worked";
        bounds = (0, None);
    };
    N[]
    {
        name = "CES labor-capital aggregate";
        bounds = (0, None);
    };
    A[]
    {
        name = "Total factor productivity";
        bounds = (0, None);
    };

    r[]
    {
        name = "Rental rate of capital";
        bounds = (0, None);
    };
    w[]
    {
        name = "Real wage";
        bounds = (0, None);
    };
    mc[]
    {
        name = "Marginal cost";
        bounds = (0, None);
    };
    lambda[]
    {
        name = "Marginal utility of wealth";
        bounds = (0, None);
    };
    f1[]
    {
        name = "CES capital share term";
    };
    f2[]
    {
        name = "CES labor share term";
    };

    u[]
    {
        name = "Period utility";
    };
    U[]
    {
        name = "Lifetime utility";
    };
    TC[]
    {
        name = "Total factor cost";
        bounds = (None, 0);
    };
    epsilon_A[]
    {
        name = "Technology shock";
    };

    alpha
    {
        name = "Capital share of the CES aggregate";
        bounds = (0, 1);
    };
    psi
    {
        name = "Elasticity of substitution between capital and labor";
        bounds = (0, None);
    };
    Theta
    {
        name = "CES scale parameter";
        bounds = (0, None);
    };
    beta
    {
        name = "Discount factor";
        bounds = (0, 1);
    };
    delta
    {
        name = "Depreciation rate";
        bounds = (0, 1);
    };
    rho_A
    {
        name = "Technology shock persistence";
        bounds = (0, 1);
    };
    sigma_C
    {
        name = "Inverse elasticity of intertemporal substitution";
        bounds = (0, None);
    };
    sigma_L
    {
        name = "Inverse Frisch elasticity of labor supply";
        bounds = (0, None);
    };
};

tryreduce
{
    U[], TC[];
};


block Steady_State
{
    definitions
    {
        f1[ss] = r[ss] ^ (psi - 1) * alpha ^ ((1 - psi) / psi) * (A[ss] * mc[ss]) ^ (1 - psi);
        N[ss] = ((f1[ss] - alpha ^ (1 / psi)) / (1 - alpha) ^ (1 / psi)) ^ (psi / (1 - psi));
        f2[ss] = alpha ^ (1 / psi) * N[ss] ^ ((psi - 1) / psi) + (1 - alpha) ^ (1 / psi);
    };

    identities
    {
        A[ss] = 1.0;
        r[ss] = 1 / beta - (1 - delta);
        mc[ss] = 1.0;

        w[ss] = (1 - alpha) ^ (1 / psi) * A[ss] * mc[ss] * f2[ss] ^ (1 / (psi - 1));

        L[ss] = (w[ss] / Theta) ^ (1 / (sigma_L + sigma_C)) *
            (A[ss] * f2[ss]  ^ (psi / (psi - 1)) -  delta * N[ss]) ^ (-sigma_C / (sigma_L + sigma_C));

        K[ss] = N[ss] * L[ss];
        I[ss] = delta * K[ss];
        Y[ss] = A[ss] * (alpha ^ (1 / psi) * K[ss] ^ ((psi - 1) / psi) +
                        (1 - alpha) ^ (1 / psi) * L[ss] ^ ((psi - 1) / psi)) ^ (psi / (psi - 1));
        C[ss] = Y[ss] - I[ss];

        lambda[ss] = C[ss] ^ (-sigma_C);
    };

};

block Household
{
    definitions
    {
        u[] = C[] ^ (1 - sigma_C) / (1 - sigma_C) - Theta * L[] ^ (1 + sigma_L) / (1 + sigma_L);
    };

    controls
    {
        C[], L[], I[], K[];
    };

    objective
    {
        U[] = u[] + beta * E[][U[1]];
    };

    constraints
    {
        C[] + I[] = r[] * K[-1] + w[] * L[] : lambda[];

        K[] = (1 - delta) * K[-1] + I[];
    };

    calibration
    {
        beta = 0.99;
        delta = 0.02;
        sigma_C = 1.5;
        sigma_L = 2.0;
        Theta = 1.0;
    };
};

block Firm
{
    controls
    {
        K[-1], L[];
    };

    objective
    {
        TC[] = -(r[] * K[-1] + w[] * L[]);
    };

    constraints
    {
        Y[] = A[] * (alpha ^ (1 / psi) * K[-1] ^ ((psi - 1) / psi) +
               (1 - alpha) ^ (1 / psi) * L[] ^ ((psi - 1) / psi)
                     ) ^ (psi / (psi - 1)): mc[];
    };

    identities
    {
        # Perfect competition
        mc[] = 1;
    };

    calibration
    {
        alpha = 0.35;
        psi = 0.6;
    };
};

block Technology_Shocks
{
    identities
    {
        log(A[]) = rho_A * log(A[-1]) + epsilon_A[];
    };

    shocks
    {
        epsilon_A[];
    };

    calibration
    {
        rho_A = 0.95;
    };
};

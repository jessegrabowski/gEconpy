symbols
{
    Y[]
    {
        name = "Output";
        bounds = (0, None);
    };
    C[]
    {
        name = "Aggregate consumption";
        bounds = (0, None);
    };
    I[]
    {
        name = "Investment";
        bounds = (0, None);
    };
    K[]
    {
        name = "Capital stock";
        bounds = (0, None);
    };
    L[]
    {
        name = "Aggregate hours worked";
        bounds = (0, None);
    };
    N[]
    {
        name = "Aggregate labor supply";
        bounds = (0, None);
    };
    TFP[]
    {
        name = "Total factor productivity";
        bounds = (0, None);
    };

    C_R[]
    {
        name = "Consumption, Ricardian household";
        bounds = (0, None);
    };
    L_R[]
    {
        name = "Hours worked, Ricardian household";
        bounds = (0, None);
    };
    U_R[]
    {
        name = "Lifetime utility, Ricardian household";
    };
    u_R[]
    {
        name = "Period utility, Ricardian household";
    };
    lambda_R[]
    {
        name = "Marginal utility of wealth, Ricardian household";
        bounds = (0, None);
    };

    C_NR[]
    {
        name = "Consumption, non-Ricardian household";
        bounds = (0, None);
    };
    L_NR[]
    {
        name = "Hours worked, non-Ricardian household";
        bounds = (0, None);
    };
    U_NR[]
    {
        name = "Lifetime utility, non-Ricardian household";
    };
    u_NR[]
    {
        name = "Period utility, non-Ricardian household";
    };
    lambda_NR[]
    {
        name = "Marginal utility of wealth, non-Ricardian household";
        bounds = (0, None);
    };

    r[]
    {
        name = "Rental rate of capital";
        bounds = (0, None);
    };
    w[]
    {
        name = "Real wage";
        bounds = (0, None);
    };
    mc[]
    {
        name = "Marginal cost";
        bounds = (0, None);
    };
    q[]
    {
        name = "Shadow value of installed capital";
        bounds = (0, None);
    };
    TC[]
    {
        name = "Total factor cost";
        bounds = (None, 0);
    };

    Theta_R[]
    {
        name = "Labor disutility shifter, Ricardian household";
        bounds = (0, None);
    };
    Theta_N[]
    {
        name = "Labor disutility shifter, aggregate";
        bounds = (0, None);
    };
    shock_beta_R[]
    {
        name = "Discount factor shifter, Ricardian household";
        bounds = (0, None);
    };
    epsilon_TFP[]
    {
        name = "Technology shock";
    };
    epsilon_beta_R[]
    {
        name = "Discount factor shock";
    };
    epsilon_Theta_R[]
    {
        name = "Ricardian labor disutility shock";
    };
    epsilon_Theta_N[]
    {
        name = "Aggregate labor disutility shock";
    };

    alpha
    {
        name = "Capital share of output";
        bounds = (0, 1);
    };
    beta
    {
        name = "Discount factor";
        bounds = (0, 1);
    };
    delta
    {
        name = "Depreciation rate";
        bounds = (0, 1);
    };
    omega
    {
        name = "Population share of Ricardian households";
        bounds = (0, 1);
    };
    Theta_R
    {
        name = "Mean labor disutility, Ricardian household";
        bounds = (0, None);
    };
    Theta_N
    {
        name = "Mean labor disutility, aggregate";
        bounds = (0, None);
    };
    sigma_R
    {
        name = "Inverse Frisch elasticity, Ricardian household";
        bounds = (0, None);
    };
    sigma_N
    {
        name = "Inverse Frisch elasticity, aggregate";
        bounds = (0, None);
    };
    rho_TFP
    {
        name = "Technology shock persistence";
        bounds = [0, 1);
    };
    rho_beta_R
    {
        name = "Discount factor shock persistence";
        bounds = [0, 1);
    };
    rho_Theta_R
    {
        name = "Ricardian labor disutility persistence";
        bounds = [0, 1);
    };
    rho_Theta_N
    {
        name = "Aggregate labor disutility persistence";
        bounds = [0, 1);
    };
};

tryreduce
{
    U_NR[], U_R[], TC[];
};

block Steady_State
{
    definitions
    {
        # Capital/Labor ratio, N = K/L
        N[ss] = (alpha * TFP[ss] / r[ss]) ^ (1 / (1 - alpha));

    };
    identities
    {
        TFP[ss] = 1.0;
        shock_beta_R[ss] = 1.0;
        Theta_R[ss] = Theta_R;
        Theta_N[ss] = Theta_N;

        r[ss] = 1 / beta - (1 - delta);
        w[ss] = (1 - alpha) * N[ss] ^ alpha;

        C_R[ss] = (w[ss] / Theta_R) ^ (1 / sigma_R);
        C_NR[ss] = (w[ss] / Theta_N) ^ (1 / sigma_N);

        C[ss] = omega * C_R[ss] + (1 - omega) * C_NR[ss];
        L[ss] = C[ss] / (N[ss] ^ alpha - delta * N[ss]);
        L_NR[ss] = C_NR[ss] / w[ss];
        L_R[ss] = (L[ss] - (1 - omega) * L_NR[ss]) / omega;

        K[ss] = N[ss] * L[ss];
        I[ss] = delta * K[ss];
        Y[ss] = C[ss] + I[ss];

        lambda_R[ss] = C_R[ss] ^ -sigma_R;
        lambda_NR[ss] = C_NR[ss] ^ -sigma_N;
        q[ss] = lambda_R[ss];
    };
};

block Ricardian_Household
{
    definitions
    {
        u_R[] = shock_beta_R[] * (C_R[] ^ (1 - sigma_R) / (1 - sigma_R) - Theta_R[] * L_R[]);
    };

    controls
    {
        C_R[], L_R[], I[], K[];
    };

    objective
    {
        U_R[] = u_R[] + beta * E[][U_R[1]];
    };

    constraints
    {
        @exclude
        C_R[] + I[] = r[] * K[-1] + w[] * L_R[] : lambda_R[];

        K[] = (1 - delta) * K[-1] + I[]: q[];
    };

    identities
    {
        log(shock_beta_R[]) = rho_beta_R * log(shock_beta_R[-1]) + epsilon_beta_R[];
        log(Theta_R[]) = (1 - rho_Theta_R) * log(Theta_R) + rho_Theta_R * log(Theta_R[-1]) + epsilon_Theta_R[];
    };

    shocks
    {
        epsilon_beta_R[], epsilon_Theta_R[];
    };

    calibration
    {
        beta  ~ maxent(Beta(), lower=0.90, upper=0.99) = 0.99;
        delta ~ maxent(Beta(), lower=0.01, upper=0.05) = 0.02;
        sigma_R ~ maxent(Gamma(), lower=1.1, upper=3.0) = 1.5;
        Theta_R ~ maxent(Gamma(), lower=0.1, upper=5.0) = 1.0;
        rho_beta_R  ~ maxent(Beta(), lower=0.5, upper=0.99) = 0.95;
        rho_Theta_R  ~ maxent(Beta(), lower=0.5, upper=0.99) = 0.95;
    };
};

block Non_Ricardian_Household
{
    definitions
    {
        u_NR[] = C_NR[] ^ (1 - sigma_N) / (1 - sigma_N) - Theta_N[] * L_NR[];
    };

    controls
    {
        C_NR[], L_NR[];
    };

    objective
    {
        U_NR[] = u_NR[] + beta * E[][U_NR[1]];
    };

    constraints
    {
        C_NR[] = w[] * L_NR[]: lambda_NR[];
    };

    identities
    {
        log(Theta_N[]) = (1 - rho_Theta_N) * log(Theta_N) + rho_Theta_N * log(Theta_N[-1]) + epsilon_Theta_N[];
    };

    shocks
    {
        epsilon_Theta_N[];
    };

    calibration
    {
        Theta_N ~ maxent(Gamma(), lower=0.1, upper=5.0) = 1.0;
        sigma_N ~ maxent(Gamma(), lower=1.1, upper=3.0) = 1.5;

        rho_Theta_N ~ maxent(Beta(), lower=0.5, upper=0.99) = 0.95;
    };
};


block Firm
{
    controls
    {
        K[-1], L[];
    };

    objective
    {
        TC[] = -(r[] * K[-1] + w[] * L[]);
    };

    constraints
    {
        Y[] = TFP[] * K[-1] ^ alpha * L[] ^ (1 - alpha) : mc[];
    };

    identities
    {
        # Perfect competition
        mc[] = 1;

        # Exogenous technology process
        log(TFP[]) = rho_TFP * log(TFP[-1]) + epsilon_TFP[];
    };

    shocks
    {
        epsilon_TFP[];
    };

    calibration
    {
        alpha   ~ maxent(Beta(), lower=0.3, upper=0.6) = 0.35;
        rho_TFP ~ maxent(Beta(), lower=0.8, upper=0.99) = 0.95;
    };
};

block Equlibrium
{
    identities
    {
        Y[] = C[] + I[];
        L[] = omega * L_R[] + (1 - omega) * L_NR[];
        C[] = omega * C_R[] + (1 - omega) * C_NR[];
    };

    calibration
    {
        omega ~ maxent(Beta(), lower=0.6, upper=0.99) = 0.66;
    };
};
